# Environment Variables Template for Literexia
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# MongoDB Configuration
# Get from MongoDB Atlas dashboard
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ElevenLabs TTS API
# Get from https://elevenlabs.io/app/settings
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# PlayHT TTS API (alternative/backup)
# Get from https://play.ht/app/api-access
PLAYHT_API_KEY=ak-your_playht_api_key_here
PLAYHT_USER_ID=your_playht_user_id_here

# Security Notes:
# - All API keys should be at least 32 characters long
# - Never share these credentials in chat, email, or version control
# - Rotate keys regularly (monthly recommended)
# - Use different keys for development and production
# - Monitor API usage for unusual activity

# Development vs Production:
# - Use separate credentials for dev/staging/prod environments
# - Consider using shorter-lived tokens for production
# - Implement credential rotation in production systems